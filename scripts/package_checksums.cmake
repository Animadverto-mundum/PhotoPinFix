# Generate a portable manifest of regular files without recording local paths.
if(NOT DEFINED PACKAGE_ROOT OR NOT IS_DIRECTORY "${PACKAGE_ROOT}")
  message(FATAL_ERROR "PACKAGE_ROOT must name an existing package directory")
endif()
file(GLOB_RECURSE package_files RELATIVE "${PACKAGE_ROOT}" LIST_DIRECTORIES false "${PACKAGE_ROOT}/*")
list(SORT package_files)
set(manifest "")
foreach(relative IN LISTS package_files)
  if(relative STREQUAL "SHA256SUMS" OR IS_SYMLINK "${PACKAGE_ROOT}/${relative}")
    continue()
  endif()
  file(SHA256 "${PACKAGE_ROOT}/${relative}" digest)
  string(APPEND manifest "${digest}  ${relative}\n")
endforeach()
file(WRITE "${PACKAGE_ROOT}/SHA256SUMS" "${manifest}")
