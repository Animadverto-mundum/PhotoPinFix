# PhotoPinFix writes only these two application-specific provenance properties.
# Loaded explicitly with ExifTool's -config option; never installed into HOME.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        PhotoPinFix => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::PhotoPinFix' },
        },
    },
);
%Image::ExifTool::UserDefined::PhotoPinFix = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-PhotoPinFix', 2 => 'Image' },
    NAMESPACE => { PhotoPinFix => 'urn:photopinfix:metadata:1.0/' },
    WRITABLE => 'string',
    Mode => {},
    Method => {},
);
1;
